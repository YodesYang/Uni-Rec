/* 乐享(lexiangla)比赛社区问答抓取脚本 · 浏览器 console 粘贴即跑
 *
 * 用法:
 *   1. Chrome/Edge 打开:
 *        https://lexiangla.com/questions?company_from=9cfe03d211a311f1a8588ad12dbe613c
 *      (或任意带 company_from 的问答列表页)
 *   2. 登录后, F12 → Console, 粘贴本文件全部内容并回车 → 自动滚动收集列表。
 *   3. (可选) 列表收集完后, 控制台输入:
 *        await window._lx_fetchDetails()       // 自动猜端点抓详情+回答
 *      若日志显示「✗ 全部端点失败」 → 说明我猜的 API 路径不对, 改走「手动模式」:
 *        在新标签页里挨个点开每个问题(本脚本的 hook 会自动截获详情/回答 XHR);
 *        点完所有想要的问题后, 回到原列表页执行下一步。
 *   4. 导出:
 *        window._lx_export()                   // 同时下载 .json 和 .md
 *
 * 设计原则:
 *   - 不依赖我对乐享 API 的先验知识: 主路径靠 hook 浏览器原生 fetch/XHR 被动截获;
 *     猜端点(`_lx_fetchDetails`)只是 fallback。
 *   - 不写 cookie / 不发跨域请求 / 不上报任何远端: 全部数据落到浏览器下载目录。
 *   - 重复粘贴本脚本不会重复 hook fetch (有 `_lx_hooked` 守卫)。
 */

(async () => {
  if (window._lx_state) {
    console.warn('[lx] 已存在 window._lx_state, 复用之前的状态。如要重置请刷新页面。');
  } else {
    window._lx_state = {
      list: [],            // [{ id, url, title, meta_text, api? }]
      details: {},         // id -> { id, detail, answers }
      api: { list: [], detail: [], answer: [], other: [] }, // 截获的 XHR
    };
  }
  const S = window._lx_state;
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const log = (...a) => console.log('[lx]', ...a);

  // ---- 1. Hook fetch & XHR (一次性) ----
  if (!window._lx_hooked) {
    const classify = (url) => {
      if (/answer/i.test(url)) return 'answer';
      if (/question/i.test(url)) {
        // 含 long id 的视为详情, 否则列表
        return /\/questions?\/[\w-]{6,}/i.test(url) ? 'detail' : 'list';
      }
      return 'other';
    };
    const isApi = (url) => /\/(api|cgi-bin|graphql)\b/i.test(url) && /question|answer/i.test(url);

    const origFetch = window.fetch;
    window.fetch = async function (...args) {
      const res = await origFetch.apply(this, args);
      try {
        const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url) || '';
        if (isApi(url)) {
          const ctype = res.headers.get('content-type') || '';
          if (ctype.includes('json')) {
            res.clone().json().then(json => {
              const bucket = classify(url);
              S.api[bucket].push({ url, json, t: Date.now() });
              log(`📥 fetch [${bucket}] ${url.split('?')[0]}`);
            }).catch(() => {});
          }
        }
      } catch (e) {}
      return res;
    };

    const origOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url, ...rest) {
      this._lx_url = url;
      return origOpen.call(this, method, url, ...rest);
    };
    const origSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function (...args) {
      this.addEventListener('load', () => {
        try {
          const url = this._lx_url || '';
          if (!isApi(url)) return;
          const ctype = (this.getResponseHeader && this.getResponseHeader('content-type')) || '';
          if (!ctype.includes('json')) return;
          const json = JSON.parse(this.responseText);
          const bucket = classify(url);
          S.api[bucket].push({ url, json, t: Date.now() });
          log(`📥 XHR [${bucket}] ${String(url).split('?')[0]}`);
        } catch (e) {}
      });
      return origSend.apply(this, args);
    };

    window._lx_hooked = true;
    log('✅ fetch / XHR 已 hook');
  }

  // ---- 2. 自动滚动到底, 触发懒加载 ----
  await sleep(500);
  // 优先找页面里真正的滚动容器(SPA 常用内嵌 scrollable div), 否则退回到 document
  const findScrollable = () => {
    const docSc = document.scrollingElement || document.documentElement;
    const candidates = Array.from(document.querySelectorAll('div'))
      .filter(el => el.scrollHeight > el.clientHeight + 200 && el.clientHeight > 200);
    candidates.sort((a, b) => (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight));
    return candidates[0] || docSc;
  };
  const sc = findScrollable();
  log(`滚动容器: ${sc === document.scrollingElement ? '<document>' : sc.className || '<div>'}, 初始高度=${sc.scrollHeight}`);

  let prevHeight = -1;
  let stableRounds = 0;
  const MAX_ROUNDS = 200;
  for (let i = 0; i < MAX_ROUNDS && stableRounds < 4; i++) {
    if (sc === document.scrollingElement) {
      window.scrollTo(0, document.body.scrollHeight);
    } else {
      sc.scrollTop = sc.scrollHeight;
    }
    await sleep(1100);
    const h = sc.scrollHeight;
    if (h === prevHeight) stableRounds++; else { stableRounds = 0; prevHeight = h; }
    if (i % 5 === 0) log(`  · 滚动 ${i + 1} 次, 高度=${h}, 稳定=${stableRounds}/4`);
  }
  log('✅ 列表滚动结束');

  // ---- 3. DOM scrape (兜底, 即使 XHR 没截到也能拿到 id+title+url) ----
  const cards = Array.from(document.querySelectorAll('a[href*="/question"]'));
  let domAdded = 0;
  cards.forEach(a => {
    const href = a.href;
    const m = href.match(/\/questions?\/([\w-]+)/i);
    if (!m) return;
    const id = m[1];
    if (S.list.find(x => String(x.id) === String(id))) return;
    const root = a.closest('[class*="card"], [class*="item"], [class*="Card"], li, article') || a;
    const title = (a.innerText || '').trim().split('\n')[0] || '(无标题)';
    S.list.push({
      id: String(id),
      url: href,
      title,
      meta_text: (root.innerText || '').trim(),
    });
    domAdded++;
  });
  log(`✅ DOM 扫描新增 ${domAdded} 题, 累计 ${S.list.length}`);

  // ---- 4. 把截获的列表 XHR 合并进 S.list ----
  let apiAdded = 0;
  const pickItems = (json) => {
    // 容错地从常见嵌套位置取出 items 数组
    const tries = [
      json && json.data && json.data.items,
      json && json.data && json.data.list,
      json && json.data && json.data.questions,
      json && json.data && json.data.records,
      json && json.items,
      json && json.list,
      Array.isArray(json && json.data) ? json.data : null,
      Array.isArray(json) ? json : null,
    ];
    return tries.find(x => Array.isArray(x)) || [];
  };
  for (const cap of S.api.list) {
    for (const it of pickItems(cap.json)) {
      const id = String(it.id || it.question_id || it.knowledge_id || '');
      if (!id) continue;
      let row = S.list.find(x => String(x.id) === id);
      if (!row) {
        row = { id, url: `/questions/${id}`, title: it.title || it.subject || '(无标题)' };
        S.list.push(row);
        apiAdded++;
      }
      row.api = it;
    }
  }
  log(`✅ XHR 列表合并新增 ${apiAdded}, 总计 ${S.list.length} 题`);

  log(
    '🎉 列表收集完成。下一步:\n' +
    '  await window._lx_fetchDetails();   // (可选) 自动猜端点批量抓详情+回答\n' +
    '  window._lx_export();               // 导出 JSON + Markdown 到下载目录\n' +
    '\n' +
    '若 _lx_fetchDetails() 全部失败 → 改走手动模式:\n' +
    '  在新标签页逐个点开问题, 本脚本的 hook 会自动截获 → 回原页执行 _lx_export()'
  );
})();

window._lx_fetchDetails = async function (opts) {
  opts = opts || {};
  const sleepMs = opts.sleepMs != null ? opts.sleepMs : 800;
  const limit = opts.limit != null ? opts.limit : null;
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const S = window._lx_state;
  if (!S || !S.list.length) {
    console.warn('[lx] 列表为空, 请先粘贴主脚本完成列表收集');
    return;
  }
  // 候选端点(命中一个即用); 后续若发现真实端点再加
  const detailEPs = (id) => [
    `/api/v1/questions/${id}`,
    `/api/questions/${id}`,
    `/cgi-bin/v1/questions/${id}`,
  ];
  const answerEPs = (id) => [
    `/api/v1/questions/${id}/answers?limit=50`,
    `/api/questions/${id}/answers?limit=50`,
    `/cgi-bin/v1/questions/${id}/answers?limit=50`,
  ];
  const tryFetch = async (eps) => {
    for (const ep of eps) {
      try {
        const r = await fetch(ep, { credentials: 'include', headers: { 'Accept': 'application/json' } });
        const ctype = r.headers.get('content-type') || '';
        if (r.ok && ctype.includes('json')) return await r.json();
      } catch (e) {}
    }
    return null;
  };

  const todo = S.list.slice(0, limit == null ? S.list.length : limit);
  console.log(`[lx] 开始抓详情, 共 ${todo.length} 题, 间隔 ${sleepMs}ms`);
  let ok = 0, fail = 0;
  for (let i = 0; i < todo.length; i++) {
    const q = todo[i];
    if (S.details[q.id] && S.details[q.id].detail) { ok++; continue; }
    const detail = await tryFetch(detailEPs(q.id));
    const answers = await tryFetch(answerEPs(q.id));
    S.details[q.id] = { id: q.id, detail, answers };
    if (detail || answers) { ok++; console.log(`[lx] ✓ (${i + 1}/${todo.length}) ${q.title}`); }
    else { fail++; console.log(`[lx] ✗ (${i + 1}/${todo.length}) ${q.title} 全部端点失败`); }
    await sleep(sleepMs);
  }

  // 把任何被动截获的详情/回答也并进来(即使猜端点失败也能补全)
  const idFromUrl = (url) => {
    const m = String(url).match(/questions?\/([\w-]+)/i);
    return m ? String(m[1]) : null;
  };
  for (const cap of S.api.detail) {
    const id = idFromUrl(cap.url);
    if (!id) continue;
    if (!S.details[id]) S.details[id] = { id };
    if (!S.details[id].detail) S.details[id].detail = cap.json;
  }
  for (const cap of S.api.answer) {
    const id = idFromUrl(cap.url);
    if (!id) continue;
    if (!S.details[id]) S.details[id] = { id };
    if (!S.details[id].answers) S.details[id].answers = cap.json;
  }

  console.log(`[lx] ✅ 详情阶段完成: 成功 ${ok} / 失败 ${fail}, 详情库 ${Object.keys(S.details).length} 题`);
  if (fail > 0 && ok === 0) {
    console.log(
      '[lx] ⚠ 全部端点猜测失败 → 改走手动模式:\n' +
      '  打开 Network 面板, 点开任意一个问题, 找到那条 200 的 application/json 请求, 把 URL 模板告诉我, 我再补到脚本里。\n' +
      '  或者: 你直接在新标签页挨个点开问题, hook 会被动截获, 然后 _lx_export()。'
    );
  }
};

window._lx_export = function () {
  const S = window._lx_state;
  if (!S) { console.warn('[lx] 未初始化'); return; }
  const ts = new Date().toISOString().replace(/[:T]/g, '-').slice(0, 19);
  const stripHtml = (s) => String(s || '').replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '').replace(/<[^>]+>/g, '').replace(/\n{3,}/g, '\n\n').trim();
  const pickContent = (obj) => {
    if (!obj) return '';
    const tries = [
      obj.data && obj.data.content,
      obj.data && obj.data.body,
      obj.data && obj.data.html,
      obj.content, obj.body, obj.html,
    ];
    return tries.find(x => typeof x === 'string' && x.length) || '';
  };
  const pickAnswerList = (obj) => {
    if (!obj) return [];
    const tries = [
      obj.data && obj.data.items, obj.data && obj.data.list, obj.data && obj.data.answers,
      obj.items, obj.list, obj.answers,
      Array.isArray(obj.data) ? obj.data : null,
      Array.isArray(obj) ? obj : null,
    ];
    return tries.find(x => Array.isArray(x)) || [];
  };

  const payload = {
    crawled_at: new Date().toISOString(),
    source_url: location.href,
    total: S.list.length,
    questions: S.list.map(q => ({
      id: q.id,
      url: q.url,
      title: q.title,
      meta_text: q.meta_text || null,
      api_summary: q.api || null,
      detail_raw: (S.details[q.id] && S.details[q.id].detail) || null,
      answers_raw: (S.details[q.id] && S.details[q.id].answers) || null,
    })),
  };

  const dl = (blob, name) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click();
    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 1000);
  };

  // ---- JSON ----
  dl(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }),
     `lexiang_questions_${ts}.json`);

  // ---- Markdown ----
  const lines = [];
  lines.push(`# 乐享比赛社区问答快照`);
  lines.push('');
  lines.push(`- 抓取时间: ${payload.crawled_at}`);
  lines.push(`- 来源: ${payload.source_url}`);
  lines.push(`- 总题数: ${payload.total}`);
  lines.push('');
  lines.push('---');
  lines.push('');
  for (const q of payload.questions) {
    lines.push(`## ${q.title || '(无标题)'}`);
    lines.push('');
    lines.push(`- ID: \`${q.id}\``);
    lines.push(`- 链接: ${q.url}`);
    const a = q.api_summary || {};
    if (a.created_at) lines.push(`- 时间: ${a.created_at}`);
    if (a.user && (a.user.name || a.user.nickname)) lines.push(`- 提问者: ${a.user.name || a.user.nickname}`);
    if (a.view_count != null) lines.push(`- 浏览: ${a.view_count}`);
    if (a.answer_count != null) lines.push(`- 回答数: ${a.answer_count}`);
    lines.push('');
    const body = pickContent(q.detail_raw && q.detail_raw.data ? q.detail_raw : { data: q.detail_raw });
    if (body) {
      lines.push('### 正文');
      lines.push('');
      lines.push(stripHtml(body));
      lines.push('');
    }
    const answers = pickAnswerList(q.answers_raw);
    if (answers.length) {
      lines.push(`### 回答 (${answers.length})`);
      lines.push('');
      answers.forEach((ans, idx) => {
        const author = (ans.user && (ans.user.name || ans.user.nickname)) || '(匿名)';
        const t = ans.created_at || ans.updated_at || '';
        const content = stripHtml(ans.content || ans.body || ans.html || '');
        lines.push(`#### #${idx + 1} @${author}${t ? ' · ' + t : ''}`);
        lines.push('');
        lines.push(content || '(空)');
        lines.push('');
      });
    } else if (q.detail_raw || q.answers_raw) {
      lines.push('_(未取到结构化回答, 请查看 JSON 中的 answers_raw)_');
      lines.push('');
    }
    lines.push('---');
    lines.push('');
  }
  dl(new Blob([lines.join('\n')], { type: 'text/markdown' }),
     `lexiang_questions_${ts}.md`);

  console.log(`[lx] ✅ 已触发下载: lexiang_questions_${ts}.json 和 .md`);
};
