# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Local virtualenv ---
.venv/
venv/

# --- Local data & training artifacts (do NOT submit to platform via git) ---
data/
runs/

# --- Generated platform entry templates ---
# The platform entrypoint is uploaded as run.sh. Local run_*.sh templates are
# transient helpers and should not be committed. Keep them under
# platform_run_templates/ instead of src/ to avoid mixing with source files.
platform_run_templates/run_*.sh
src/run_*.sh

# --- Source PDF (oversized, image-only; markdown 解析版本已落到 docs/00-context/) ---
docs/99-raw/platform-pdf/*.pdf

# --- Lexiang community raw JSON snapshots (oversized; 情报已沉淀到 docs/10-research/community-intel.md) ---
docs/99-raw/community-snapshots/lexiang_questions_*.json

# --- External reference repos (clone-for-inspection; 情报已沉淀到 docs/10-research/) ---
docs/99-raw/external-refs/

